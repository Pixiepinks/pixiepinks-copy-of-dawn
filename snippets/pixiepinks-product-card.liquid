{% liquid
  assign variant = product.selected_or_first_available_variant
  assign badge = blank
  if product.available == false
    assign badge = 'Sold out'
  elsif product.compare_at_price_max > product.price
    assign saving = product.compare_at_price_max | minus: product.price | times: 100 | divided_by: product.compare_at_price_max
    assign badge = saving | append: '% off'
  elsif show_new and product.tags contains 'new'
    assign badge = 'New'
  endif
%}
<article class="pp-card">
  <a class="pp-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
    {% if badge != blank %}<span class="pp-card__badge">{{ badge }}</span>{% endif %}
    {% if product.featured_media != blank %}
      {{ product.featured_media | image_url: width: 700 | image_tag: widths: '240, 360, 500, 700', sizes: '(max-width: 749px) 50vw, 20vw', loading: 'lazy', alt: product.featured_media.alt | default: product.title }}
      {% if show_secondary and product.media[1] != blank %}{{ product.media[1] | image_url: width: 700 | image_tag: widths: '240, 360, 500, 700', sizes: '(max-width: 749px) 50vw, 20vw', loading: 'lazy', alt: product.media[1].alt | default: product.title }}{% endif %}
    {% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}
  </a>
  <div class="pp-card__content">
    <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <div class="pp-card__price"><span>{{ product.price | money }}</span>{% if product.compare_at_price_max > product.price %}<s>{{ product.compare_at_price_max | money }}</s>{% endif %}</div>
    {% if quick_add %}
      {% if variant.available %}<form method="post" action="{{ routes.cart_add_url }}" data-pp-quick-add><input type="hidden" name="id" value="{{ variant.id }}"><input type="hidden" name="quantity" value="1"><button class="pp-button" type="submit">Quick add</button></form>{% else %}<form><button class="pp-button" type="button" disabled>Sold out</button></form>{% endif %}
    {% endif %}
  </div>
</article>
