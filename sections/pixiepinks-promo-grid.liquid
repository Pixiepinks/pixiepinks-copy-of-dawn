<section class="pp-section pp-container">
  {% if section.settings.heading != blank %}<div class="pp-heading-row"><h2>{{ section.settings.heading }}</h2></div>{% endif %}
  <div class="pp-promos">
    {% for block in section.blocks %}
      <article class="pp-promo" {{ block.shopify_attributes }}>
        <picture class="pp-promo__media">
          {% if block.settings.mobile_image != blank %}<source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image | image_url: width: 750 }}">{% endif %}
          {% if block.settings.desktop_image != blank %}{{ block.settings.desktop_image | image_url: width: 1100 | image_tag: widths: '400, 700, 1100', sizes: '(max-width: 749px) calc(100vw - 24px), 33vw', loading: 'lazy', alt: block.settings.heading }}{% else %}{{ 'collection-1' | placeholder_svg_tag }}{% endif %}
        </picture>
        <div class="pp-promo__content"><h3>{{ block.settings.heading }}</h3>{% if block.settings.subheading != blank %}<p>{{ block.settings.subheading }}</p>{% endif %}{% if block.settings.button_label != blank %}<a class="pp-button" href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.button_label }}</a>{% endif %}</div>
      </article>
    {% endfor %}
  </div>
</section>
{% schema %}
{"name":"PixiePinks promo cards","max_blocks":6,"settings":[{"type":"text","id":"heading","label":"Heading"}],"blocks":[{"type":"promo","name":"Promotion","settings":[{"type":"image_picker","id":"desktop_image","label":"Desktop image"},{"type":"image_picker","id":"mobile_image","label":"Mobile image"},{"type":"text","id":"heading","label":"Heading","default":"Special Gift Packs"},{"type":"text","id":"subheading","label":"Subheading","default":"For every occasion"},{"type":"text","id":"button_label","label":"Button label","default":"Shop now"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"PixiePinks promo cards","blocks":[{"type":"promo"},{"type":"promo","settings":{"heading":"Kids Bicycles","subheading":"Ride into happiness"}},{"type":"promo","settings":{"heading":"School Supplies","subheading":"Be ready for a bright year"}}]}]}
{% endschema %}
