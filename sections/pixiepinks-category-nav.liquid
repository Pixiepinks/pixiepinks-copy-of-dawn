<section class="pp-section pp-container">
  {% if section.settings.heading != blank %}<div class="pp-heading-row"><h2>{{ section.settings.heading }}</h2></div>{% endif %}
  <div class="pp-categories" role="list" aria-label="{{ section.settings.heading | default: 'Shop by category' | escape }}">
    {% for block in section.blocks %}{% if block.settings.link != blank %}<a class="pp-category" role="listitem" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{% else %}<div class="pp-category" role="listitem" {{ block.shopify_attributes }}>{% endif %}<div class="pp-category__image" style="--pp-bg:{{ block.settings.background }}">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 240 | image_tag: widths: '100, 160, 240', sizes: '106px', loading: 'lazy', alt: block.settings.title }}{% else %}<span class="pp-placeholder" aria-hidden="true">{{ block.settings.emoji }}</span>{% endif %}</div><span>{{ block.settings.title }}</span>{% if block.settings.link != blank %}</a>{% else %}</div>{% endif %}{% endfor %}
  </div>
</section>
{% schema %}
{"name":"PP Category Nav","max_blocks":16,"settings":[{"type":"text","id":"heading","label":"Heading"}],"blocks":[{"type":"category","name":"Category","settings":[{"type":"image_picker","id":"image","label":"Image / icon"},{"type":"text","id":"emoji","label":"Placeholder icon","default":"🎁"},{"type":"text","id":"title","label":"Title","default":"Gift Packs"},{"type":"url","id":"link","label":"Collection or page link"},{"type":"color","id":"background","label":"Background","default":"#ffe8f1"}]}],"presets":[{"name":"PP Category Nav","blocks":[{"type":"category","settings":{"title":"Bicycles","emoji":"🚲","background":"#daf3ff"}},{"type":"category","settings":{"title":"Toys","emoji":"🧸","background":"#fff0e5"}},{"type":"category"},{"type":"category","settings":{"title":"School Bags","emoji":"🎒","background":"#e8e1ff"}},{"type":"category","settings":{"title":"Kids Fashion","emoji":"👕","background":"#dff8e9"}},{"type":"category","settings":{"title":"Electric Cars","emoji":"🚗","background":"#fff1d4"}},{"type":"category","settings":{"title":"Kids Caps","emoji":"🧢","background":"#dbeeff"}},{"type":"category","settings":{"title":"Chocolates & Treats","emoji":"🍫"}},{"type":"category","settings":{"title":"School Supplies","emoji":"✏️","background":"#daf0ff"}},{"type":"category","settings":{"title":"Sweet Deals","emoji":"🧁"}}]}]}
{% endschema %}
