{% liquid
  assign enabled_count = 0
  for block in section.blocks
    if block.settings.enabled
      assign enabled_count = enabled_count | plus: 1
    endif
  endfor
%}
<section class="pp-section pp-section--tight pp-container" aria-label="{{ section.settings.accessibility_label | escape }}">
  <pp-carousel class="pp-carousel pp-hero"{% if section.settings.autoplay %} data-autoplay="{{ section.settings.interval | times: 1000 }}"{% endif %} tabindex="0">
    {% assign visible_index = 0 %}
    {% for block in section.blocks %}
      {% if block.settings.enabled %}
        {% assign visible_index = visible_index | plus: 1 %}
        {% if visible_index == 1 %}{% assign image_loading = 'eager' %}{% assign image_priority = 'high' %}{% else %}{% assign image_loading = 'lazy' %}{% assign image_priority = 'auto' %}{% endif %}
        {% liquid
          case block.settings.position
            when 'top-left'
              assign x = 'start'
              assign y = 'start'
            when 'top-center'
              assign x = 'center'
              assign y = 'start'
            when 'top-right'
              assign x = 'end'
              assign y = 'start'
            when 'middle-left'
              assign x = 'start'
              assign y = 'center'
            when 'middle-right'
              assign x = 'end'
              assign y = 'center'
            when 'bottom-left'
              assign x = 'start'
              assign y = 'end'
            when 'bottom-center'
              assign x = 'center'
              assign y = 'end'
            when 'bottom-right'
              assign x = 'end'
              assign y = 'end'
            else
              assign x = 'center'
              assign y = 'center'
          endcase
        %}
        <article class="pp-hero__slide" data-pp-slide aria-hidden="{% if visible_index == 1 %}false{% else %}true{% endif %}"{% unless visible_index == 1 %} inert{% endunless %} style="--pp-overlay:{{ block.settings.overlay | divided_by: 100.0 }};--pp-x:{{ x }};--pp-y:{{ y }};--pp-align:{{ block.settings.alignment }};--pp-text:{{ block.settings.text_color }}" {{ block.shopify_attributes }}>
          <picture class="pp-hero__media">
            {% if block.settings.mobile_image != blank %}<source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image | image_url: width: 540 }} 540w, {{ block.settings.mobile_image | image_url: width: 750 }} 750w, {{ block.settings.mobile_image | image_url: width: 1080 }} 1080w" sizes="100vw">{% endif %}
            {% if block.settings.desktop_image != blank %}
              {{ block.settings.desktop_image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 1920, 2400', sizes: '(max-width: 1700px) calc(100vw - 32px), 1680px', loading: image_loading, fetchpriority: image_priority, alt: block.settings.alt, width: block.settings.desktop_image.width, height: block.settings.desktop_image.height }}
            {% else %}{{ 'lifestyle-1' | placeholder_svg_tag }}{% endif %}
          </picture>
          {% if block.settings.heading != blank or block.settings.eyebrow != blank %}
            <div class="pp-hero__content">
              {% if block.settings.eyebrow != blank %}<p class="pp-hero__eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
              {% if block.settings.heading != blank %}<h2>{{ block.settings.heading }}</h2>{% endif %}
              {% if block.settings.subheading != blank %}<p>{{ block.settings.subheading }}</p>{% endif %}
              <div class="pp-hero__actions">
                {% if block.settings.cta_label != blank %}<a class="pp-button" href="{{ block.settings.cta_url | default: routes.all_products_collection_url }}">{{ block.settings.cta_label }}</a>{% endif %}
                {% if block.settings.secondary_label != blank %}<a class="pp-button pp-button--secondary" href="{{ block.settings.secondary_url | default: routes.all_products_collection_url }}">{{ block.settings.secondary_label }}</a>{% endif %}
              </div>
            </div>
          {% endif %}
        </article>
      {% endif %}
    {% endfor %}
    {% if enabled_count > 1 %}
      <button class="pp-carousel__arrow pp-carousel__arrow--prev" type="button" data-pp-prev aria-label="Previous slide">‹</button><button class="pp-carousel__arrow pp-carousel__arrow--next" type="button" data-pp-next aria-label="Next slide">›</button>
      <div class="pp-carousel__dots" aria-label="Choose slide">{% for i in (1..enabled_count) %}<button type="button" data-pp-dot aria-label="Show slide {{ i }}" aria-current="{% if i == 1 %}true{% else %}false{% endif %}"></button>{% endfor %}</div>
    {% endif %}
  </pp-carousel>
</section>
{% schema %}
{"name":"PixiePinks hero slider","max_blocks":12,"settings":[{"type":"text","id":"accessibility_label","label":"Accessibility label","default":"Featured promotions"},{"type":"checkbox","id":"autoplay","label":"Autoplay","default":true},{"type":"range","id":"interval","label":"Change slide every","unit":"s","min":3,"max":10,"step":1,"default":5}],"blocks":[{"type":"slide","name":"Slide","settings":[{"type":"checkbox","id":"enabled","label":"Enable slide","default":true},{"type":"image_picker","id":"desktop_image","label":"Desktop image (1920 × 650 recommended)"},{"type":"image_picker","id":"mobile_image","label":"Mobile image (1080 × 1200 recommended)"},{"type":"text","id":"alt","label":"Image alt text"},{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"inline_richtext","id":"heading","label":"Heading","default":"Kids’ happy place"},{"type":"text","id":"subheading","label":"Subheading","default":"Play, learn and grow with something magical."},{"type":"text","id":"cta_label","label":"Button label","default":"Shop now"},{"type":"url","id":"cta_url","label":"Button link"},{"type":"text","id":"secondary_label","label":"Secondary button label"},{"type":"url","id":"secondary_url","label":"Secondary button link"},{"type":"select","id":"alignment","label":"Text alignment","default":"center","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}]},{"type":"select","id":"position","label":"Text position","default":"middle-center","options":[{"value":"top-left","label":"Top left"},{"value":"top-center","label":"Top center"},{"value":"top-right","label":"Top right"},{"value":"middle-left","label":"Middle left"},{"value":"middle-center","label":"Middle center"},{"value":"middle-right","label":"Middle right"},{"value":"bottom-left","label":"Bottom left"},{"value":"bottom-center","label":"Bottom center"},{"value":"bottom-right","label":"Bottom right"}]},{"type":"range","id":"overlay","label":"Overlay opacity","min":0,"max":70,"step":5,"unit":"%","default":10},{"type":"color","id":"text_color","label":"Text color","default":"#ffffff"}]}],"presets":[{"name":"PixiePinks hero slider","blocks":[{"type":"slide"},{"type":"slide"},{"type":"slide"},{"type":"slide"},{"type":"slide"},{"type":"slide"},{"type":"slide"},{"type":"slide"}]}]}
{% endschema %}
